APP_NAME=Ocean KG Agent
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

GRAPH_EXPAND_TEMPERATURE=0.2
REPORT_TEMPERATURE=0.5

CACHE_ENABLED=true
CACHE_HIT_RATE=0.75
CACHE_TTL_SECONDS=86400

ALLOW_LLM_GRAPH_SEED=true
ALLOW_LLM_GRAPH_EXPAND=true
